# Copy to .env.local and fill in. Do not commit real secrets.

# Storage. Leave unset to use the bundled SQLite (data/venn.db).
# For Supabase, use the transaction pooler URL from Project Settings > Database:
#   postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
# Supabase requires SSL; node-postgres honours the sslmode=require suffix:
#   ...&sslmode=require
VENN_DB_URL=
# Or pin an explicit SQLite file instead of the default data/venn.db:
VENN_DB_FILE=

# Africa's Talking SMS (demo provider logs to stdout when both are unset).
# AT_USERNAME=
# AT_API_KEY=
# AT_SENDER_ID=
# AT_SANDBOX=1

# Vercel injects this into deployments automatically for @vercel/connect;
# do not set it by hand.
# VERCEL_OIDC_TOKEN=
# @vercel/connect connector to issue user-subject tokens from. Must be
# created + attached to the project in Vercel Connect first.
# VERCEL_CONNECT_CONNECTOR=opencode/venn