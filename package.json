{
  "name": "venn",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "tsx --test \"lib/**/*.test.ts\"",
    "test:postgres": "VENN_DB_URL=postgres://venn:venn@localhost:5432/venn tsx --test \"lib/**/*.test.ts\"",
    "db:up": "docker compose up -d postgres",
    "seed": "tsx scripts/seed.ts",
    "seed:reset": "tsx scripts/seed.ts --reset",
    "worker": "tsx scripts/worker.ts",
    "worker:once": "WORKER_ONCE=1 tsx scripts/worker.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@vercel/connect": "^2.4.1",
    "better-sqlite3": "^13.0.3",
    "next": "16.3.8",
    "pg": "^8.23.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true
  }
}
